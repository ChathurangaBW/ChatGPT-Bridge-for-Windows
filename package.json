{
  "name": "chatgpt-bridge-for-windows",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "bridge",
    "vscode-extension"
  ],
  "scripts": {
    "dev:bridge": "npm run dev --workspace @chatgpt-bridge/bridge",
