{
  "name": "chatgpt-bridge-vscode",
  "displayName": "ChatGPT Bridge for Windows",
  "description": "Connects VS Code directly to ChatGPT through the hosted Bridge relay. No companion EXE or localhost service required.",
  "version": "0.2.0",
  "publisher": "chathurangabw",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ChathurangaBW/ChatGPT-Bridge-for-Windows.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "vsce": {
    "dependencies": false
  },
  "contributes": {
    "commands": [
      {
        "command": "chatgptBridge.showStatus",
        "title": "ChatGPT Bridge: Show Status"
      },
      {
        "command": "chatgptBridge.copyPairingCode",
        "title": "ChatGPT Bridge: Copy Pairing Code"
      },
      {
        "command": "chatgptBridge.openPairingPage",
        "title": "ChatGPT Bridge: Open Pairing Page"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "package:vsix": "vsce package --no-dependencies --allow-missing-repository --out ../artifacts/chatgpt-bridge-vscode-0.2.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@types/ws": "^8.5.0",
    "esbuild": "0.28.1",
    "typescript": "^6.0.0",
    "ws": "8.21.1"
  }
}
