{
  "name": "chatgpt-bridge-vscode",
  "displayName": "ChatGPT Bridge for Windows",
  "description": "Publishes live VS Code editor context to the local ChatGPT Bridge service.",
  "version": "0.1.0",
  "publisher": "chathurangabw",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ChathurangaBW/ChatGPT-Bridge-for-Windows.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "chatgptBridge.showStatus",
        "title": "ChatGPT Bridge: Show Status"
      }
    ],
    "configuration": {
      "title": "ChatGPT Bridge for Windows",
      "properties": {
        "chatgptBridge.wsPort": {
          "type": "number",
          "default": 47321,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Loopback WebSocket port used by the local ChatGPT Bridge service. Reload the extension after changing this value."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:vsix": "npx --yes @vscode/vsce@3.9.2 package --allow-missing-repository --out ../artifacts/chatgpt-bridge-vscode-0.1.0.vsix"
  },
  "dependencies": {
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@types/ws": "^8.5.0",
    "typescript": "^6.0.0"
  }
}
